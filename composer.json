{
  "name": "ansermail/ansermail",
  "description": "The SDK for 鸿雁 / Anser: send and receive email through its HTTP API",
  "type": "library",
  "keywords": [
    "anser",
    "email",
    "email-api",
    "transactional-email",
    "webhooks"
  ],
  "homepage": "https://github.com/ruoyu-lab/ansermail-php",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/ruoyu-lab/ansermail-php/issues",
    "source": "https://github.com/ruoyu-lab/ansermail-php",
    "docs": "https://mail.ruoyulab.dev/docs/api"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Anser\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Anser\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit tests",
    "analyse": "phpstan analyse --level=max src"
  }
}
